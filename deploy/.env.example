# Copy to .env next to compose.yml. Secrets (ASSIST_API_KEY / FORWARD_API_KEY
# for Google) go only in .env, never in compose.yml or config.json. Pulling a
# private GHCR image needs a one-off docker login ghcr.io on the host (README.md).
RUSTYSQUEEZER_IMAGE=ghcr.io/handtrixx/rustysqueezer:latest
MODEL_NAME=rustysqueezer
MAX_SUMMARY_CHARS=12000
TAIL_TURNS=6
TAIL_CHARS=600
MAX_COMMANDS=25
MAX_FILES=60
MAX_ERRORS=20
MAX_KEY_POINTS=40
ASSIST_BASE_URL=http://rsq-aux:8080/v1
ASSIST_MODEL=qwen3.5-2b
ASSIST_TIMEOUT_MS=45000
ASSIST_MAX_CHUNKS=3
ASSIST_CHUNK_CHARS=700
ASSIST_MAX_TOKENS=140
# Google instead of a local llama.cpp server:
# ASSIST_PROVIDER=google, ASSIST_API_KEY=..., and unset ASSIST_BASE_URL.
FORWARD_BASE_URL=
FORWARD_PROVIDER=openai
FORWARD_MODEL=
