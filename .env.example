# rustysqueezer configuration (all optional - defaults shown)
# Optional JSON config file overriding detection rules, error/file patterns,
# enabled sections and section titles (see config.example.json). These env
# variables still win over the config file.
# CONFIG_PATH=/data/docker/rustysqueezer/config.json
MODEL_NAME=rustysqueezer

MAX_SUMMARY_CHARS=12000
TAIL_TURNS=6
TAIL_CHARS=600
MAX_COMMANDS=25
MAX_FILES=60
MAX_ERRORS=20
MAX_KEY_POINTS=40

# Small-model assist (optional): condense the key-points bullets with a local
# llama.cpp server, chunk by chunk. Empty ASSIST_BASE_URL = off, and the
# summary stays byte-identical to the pure extractive build. Failed or timed
# out chunks keep their original extractive bullets.
# ASSIST_BASE_URL=http://rsq-aux:8080/v1
ASSIST_MODEL=qwen3.5-2b
ASSIST_TIMEOUT_MS=15000
ASSIST_MAX_CHUNKS=3
ASSIST_CHUNK_CHARS=700
ASSIST_MAX_TOKENS=140

