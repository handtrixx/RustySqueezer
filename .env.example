# local-compact configuration (all optional - defaults shown)
MODEL_NAME=local-compact

MAX_SUMMARY_CHARS=12000
TAIL_TURNS=6
TAIL_CHARS=600
MAX_COMMANDS=25
MAX_FILES=60
MAX_ERRORS=20
MAX_KEY_POINTS=40

# Optional generative assist by a small local model (llama.cpp / Ollama / vLLM)
ASSIST_ENABLED=false
ASSIST_MODEL_URL=http://localhost:8080/v1
ASSIST_MODEL=local-small
ASSIST_MAX_INPUT_CHARS=2500
ASSIST_MAX_TOKENS=500
