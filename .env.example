# rustysqueezer configuration (all optional - defaults shown)
# Optional JSON config file overriding detection rules, error/file patterns,
# enabled sections and section titles (see config.example.json). These env
# variables still win over the config file.
# CONFIG_PATH=/data/docker/rustysqueezer/config.json
MODEL_NAME=rustysqueezer

MAX_SUMMARY_CHARS=12000
TAIL_TURNS=6
TAIL_CHARS=600
MAX_COMMANDS=25
MAX_FILES=60
MAX_ERRORS=20
MAX_KEY_POINTS=40

